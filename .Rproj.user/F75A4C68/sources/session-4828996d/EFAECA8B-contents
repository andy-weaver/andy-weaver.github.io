/* --- CRT base ----------------------------------------------------------- */
:root {
  /* green phosphor + deep black */
  --crt-bg: #070a07;
  --crt-green: #6dff5b;   /* main text */
  --crt-green-dim: #34d058; /* secondary */
  --crt-glow: rgba(122, 255, 104, 0.25);

  --font-ui: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono",
             "Courier New", monospace;

  /* responsive scale */
  --step-0: clamp(14px, 0.9rem + 0.1vw, 18px);
  --step-1: clamp(36px, 8vw + 0.5rem, 108px); /* brand size */
}

html, body {
  height: 100%;
  background: var(--crt-bg);
  color: var(--crt-green);
  font-family: var(--font-ui);
  text-rendering: optimizeLegibility;
}

/* Subtle scanlines + vignette (cheap effects) */
.crt-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background:
    radial-gradient(ellipse at center,
      rgba(120,255,120,0.08) 0%,
      rgba(0,0,0,0.0) 60%,
      rgba(0,0,0,0.6) 100%),
    repeating-linear-gradient(
      to bottom, rgba(0,0,0,0.0) 0px,
                 rgba(0,0,0,0.0) 2px,
                 rgba(0,0,0,0.12) 3px,   /* scanline every ~3px */
                 rgba(0,0,0,0.12) 4px);
}

.crt-inner {
  width: min(95vw, 1200px);
  padding: 6vmin 4vmin 10vmin;
  text-align: center;
}

/* Brand (big green pixels) */
.crt-brand {
  font-size: var(--step-1);
  line-height: 0.9;
  letter-spacing: 0.02em;
  text-shadow:
    0 0 6px var(--crt-glow),
    0 0 16px var(--crt-glow);
  margin-block: 12vh 6vh;
}

/* Buttons: large, tappable (>=44px), readable */
.crt-buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}

.btn-crt {
  --pad-y: 12px;           /* ensures 44px+ height with font-size below */
  --pad-x: 18px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: var(--pad-y) var(--pad-x);
  min-width: 120px;
  min-height: 44px;        /* WCAG touch target */
  font-size: clamp(14px, 1rem + 0.2vw, 18px);
  letter-spacing: 0.02em;

  color: var(--crt-bg);
  background: var(--crt-green);
  border: 2px solid var(--crt-green);
  text-decoration: none;
  border-radius: 6px;

  box-shadow:
    0 0 8px var(--crt-glow),
    inset 0 0 0 1px rgba(0,0,0,0.25);
  transition: transform 120ms ease, box-shadow 120ms ease,
              background-color 120ms ease, color 120ms ease;
}

.btn-crt:hover {
  transform: translateY(-1px);
  box-shadow:
    0 0 14px var(--crt-glow),
    inset 0 0 0 1px rgba(0,0,0,0.25);
}

.btn-crt:active {
  transform: translateY(0);
}

.btn-crt:focus-visible {
  outline: 3px solid #ffffffaa;
  outline-offset: 2px;
}

/* Global text sizing & links inside posts (keeps the vibe) */
p, li { font-size: var(--step-0); }
a:not(.btn-crt) { color: var(--crt-green); text-decoration-color: var(--crt-green-dim); }
a:not(.btn-crt):hover { text-shadow: 0 0 8px var(--crt-glow); }

/* Code blocks readable on dark bg */
pre, code {
  background: #0c120c;
  color: var(--crt-green);
  text-shadow: 0 0 4px rgba(109,255,91,0.2);
}
pre {
  border: 1px solid #0f170f;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.03);
}

/* Reduce effects for users who prefer less motion */
@media (prefers-reduced-motion: reduce) {
  .btn-crt { transition: none; }
}